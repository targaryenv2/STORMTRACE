# STORMTRACE Configuration Template
# Copy this file to .env and configure your environment variables.

# AI Assistant Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Backend Server Configuration
PORT=8000
DATA_SOURCE=synthetic

# Optional Credentials for Real Data Download Pipelines
# CDS_API_URL=https://cds.climate.copernicus.eu/api/v2
# CDS_API_KEY=your_cds_api_key_here
# EARTHDATA_USERNAME=your_earthdata_username
# EARTHDATA_PASSWORD=your_earthdata_password

# Demo Alert Notification Channel Configuration (Email)
# DEMO_ALERT_RECIPIENT=demo_alerts@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_smtp_username
# SMTP_PASSWORD=your_smtp_app_password
# SMTP_FROM=stormtrace-alerts@example.com
